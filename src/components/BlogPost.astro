---
import { render, type CollectionEntry } from 'astro:content';
import Site from '../layouts/Site.astro';
import Panel from './Panel.astro';
import { BOOKING_URL } from '../data/site';
import { ROUTES, formatDate, ui } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, seoTitle, description, excerpt, lang, alternate, pubDate, author, tags, readingTime, heroImage, heroAlt, ogImage, ogAlt } = post.data;
const t = ui(lang).post;
const { Content } = await render(post);

const published = pubDate.toISOString().slice(0, 10);
const absolute = (path: string) => new URL(path, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: published,
  dateModified: published,
  author: { '@type': 'Person', name: author, url: absolute(ROUTES.about[lang]) },
  publisher: { '@type': 'Organization', name: 'DNA4Digital', url: absolute('/') },
  image: absolute(ogImage ?? '/og.png'),
  mainEntityOfPage: absolute(Astro.url.pathname),
  keywords: tags,
};
---
<Site
  title={seoTitle ?? `${title} | DNA4Digital`}
  description={description}
  ogType="article"
  ogTitle={title}
  ogImage={ogImage}
  ogImageAlt={ogAlt}
  alternate={alternate}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Panel rung={3} kicker="04 · Blog">
    <article class="prose">
      <img class="post-hero" src={heroImage} alt={heroAlt} width="2400" height="1350" fetchpriority="high" />
      <h1>{title}</h1>
      <p class="lead">{excerpt}</p>
      <p class="post-meta">{author} · {formatDate(pubDate, lang)} · {readingTime} {t.minRead}</p>
      <Content />
    </article>
    <aside class="post-cta">
      <h3>{t.ctaHeading}</h3>
      <p>{t.ctaBody}</p>
      <a class="btn btn-primary" href={ROUTES.readiness[lang]}>{t.ctaButton}</a>
    </aside>
    <div class="btnrow" style="margin-top:28px">
      <a class="btn btn-ghost" href={ROUTES.blog[lang]}>&larr; {t.allPosts}</a>
      <a class="btn btn-ghost" href={BOOKING_URL} target="_blank" rel="noopener">{t.bookCall}</a>
    </div>
  </Panel>
</Site>
