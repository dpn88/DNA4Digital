---
// Cookie consent banner plus the settings dialog (privacy and accessibility). Behaviour lives in src/scripts/prefs.ts.
import { ROUTES, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = {
  en: {
    bannerTitle: 'Cookies, only if you agree',
    bannerText: "I'd like to use Google Analytics to see which pages are useful, and Leadinfo to recognise which companies visit. Neither runs unless you say yes, and you can change your mind at any time in the settings.",
    privacyLink: 'Privacy policy',
    acceptAll: 'Accept all',
    rejectAll: 'Reject all',
    choose: 'Choose',
    title: 'Settings',
    close: 'Close settings',
    tabPrivacy: 'Privacy',
    tabA11y: 'Accessibility',
    necessary: 'Necessary',
    necessaryText: 'Keeps the site working and remembers your language, these settings and your privacy choice, in your browser only. Always on.',
    analytics: 'Analytics',
    analyticsText: 'Google Analytics counts visits and shows which pages are useful, without telling me who you are.',
    marketing: 'Marketing',
    marketingText: 'Leadinfo recognises which company a visit comes from, based on its IP address, so I can follow up with businesses that might need my help.',
    save: 'Save choices',
    textSize: 'Text size',
    textSizes: ['Default', 'Large', 'Extra large'],
    still: 'Pause animations',
    stillText: 'Stops the helix and the background from moving.',
    no3d: 'Turn off the 3D background',
    no3dText: 'Shows a plain page instead and uses less battery. The page reloads.',
    contrast: 'High contrast',
    contrastText: 'Solid backgrounds and brighter text.',
    links: 'Underline links',
    linksText: 'Makes every link easy to spot.',
    spacing: 'Easier reading spacing',
    spacingText: 'Wider spacing between letters, words and lines.',
    reset: 'Reset accessibility settings',
    saved: 'Saved',
  },
  pl: {
    bannerTitle: 'Pliki cookie tylko za Twoją zgodą',
    bannerText: 'Chciałbym korzystać z Google Analytics, żeby wiedzieć, które strony są przydatne, oraz z Leadinfo, żeby rozpoznawać firmy odwiedzające stronę. Żadne z nich nie działa bez Twojej zgody, a decyzję możesz zmienić w każdej chwili w ustawieniach.',
    privacyLink: 'Polityka prywatności',
    acceptAll: 'Zaakceptuj wszystkie',
    rejectAll: 'Odrzuć wszystkie',
    choose: 'Wybierz',
    title: 'Ustawienia',
    close: 'Zamknij ustawienia',
    tabPrivacy: 'Prywatność',
    tabA11y: 'Dostępność',
    necessary: 'Niezbędne',
    necessaryText: 'Utrzymują działanie strony i zapamiętują wybrany język, te ustawienia oraz Twoją decyzję dotyczącą prywatności, wyłącznie w Twojej przeglądarce. Zawsze włączone.',
    analytics: 'Analityka',
    analyticsText: 'Google Analytics liczy odwiedziny i pokazuje, które strony są przydatne, bez wskazywania, kim jesteś.',
    marketing: 'Marketing',
    marketingText: 'Leadinfo rozpoznaje, z jakiej firmy pochodzi wizyta, na podstawie adresu IP, żebym mógł odezwać się do firm, którym moja pomoc może się przydać.',
    save: 'Zapisz wybór',
    textSize: 'Rozmiar tekstu',
    textSizes: ['Domyślny', 'Duży', 'Bardzo duży'],
    still: 'Zatrzymaj animacje',
    stillText: 'Helisa i tło przestają się poruszać.',
    no3d: 'Wyłącz trójwymiarowe tło',
    no3dText: 'Zamiast niego zobaczysz zwykłą stronę, a urządzenie zużyje mniej baterii. Strona się przeładuje.',
    contrast: 'Wysoki kontrast',
    contrastText: 'Pełne tła i jaśniejszy tekst.',
    links: 'Podkreślaj linki',
    linksText: 'Każdy link będzie łatwo zauważyć.',
    spacing: 'Większe odstępy w tekście',
    spacingText: 'Większe odstępy między literami, słowami i wierszami.',
    reset: 'Przywróć domyślne ustawienia dostępności',
    saved: 'Zapisano',
  },
}[lang];

const toggles = [
  { name: 'still', label: T.still, text: T.stillText },
  { name: 'no3d', label: T.no3d, text: T.no3dText },
  { name: 'contrast', label: T.contrast, text: T.contrastText },
  { name: 'links', label: T.links, text: T.linksText },
  { name: 'spacing', label: T.spacing, text: T.spacingText },
];
---
<section id="consent-banner" class="consent" aria-labelledby="consent-title" hidden>
  <h2 id="consent-title">{T.bannerTitle}</h2>
  <p>{T.bannerText} <a href={ROUTES.privacy[lang]}>{T.privacyLink}</a></p>
  <div class="btnrow">
    <button type="button" class="btn btn-primary btn-sm" data-consent="none">{T.rejectAll}</button>
    <button type="button" class="btn btn-primary btn-sm" data-consent="all">{T.acceptAll}</button>
    <button type="button" class="btn btn-ghost btn-sm" data-open-settings="privacy">{T.choose}</button>
  </div>
</section>

<dialog id="prefs-dialog" class="prefs" aria-labelledby="prefs-title">
  <div class="prefs-head">
    <h2 id="prefs-title">{T.title}</h2>
    <button type="button" class="prefs-close" data-close-settings aria-label={T.close}>&times;</button>
  </div>
  <div class="prefs-tabs" role="tablist">
    <button type="button" role="tab" id="prefs-tab-privacy" aria-controls="prefs-pane-privacy" aria-selected="true" data-tab="privacy">{T.tabPrivacy}</button>
    <button type="button" role="tab" id="prefs-tab-a11y" aria-controls="prefs-pane-a11y" aria-selected="false" tabindex="-1" data-tab="a11y">{T.tabA11y}</button>
  </div>

  <section class="prefs-pane" role="tabpanel" id="prefs-pane-privacy" aria-labelledby="prefs-tab-privacy">
    <div class="pref-row">
      <span><strong id="pref-necessary">{T.necessary}</strong><span class="desc">{T.necessaryText}</span></span>
      <input type="checkbox" class="switch" role="switch" checked disabled aria-labelledby="pref-necessary" />
    </div>
    <label class="pref-row">
      <span><strong>{T.analytics}</strong><span class="desc">{T.analyticsText}</span></span>
      <input type="checkbox" class="switch" role="switch" name="analytics" />
    </label>
    <label class="pref-row">
      <span><strong>{T.marketing}</strong><span class="desc">{T.marketingText}</span></span>
      <input type="checkbox" class="switch" role="switch" name="marketing" />
    </label>
    <div class="btnrow prefs-actions">
      <button type="button" class="btn btn-primary btn-sm" data-consent="save">{T.save}</button>
      <button type="button" class="btn btn-ghost btn-sm" data-consent="none">{T.rejectAll}</button>
      <button type="button" class="btn btn-ghost btn-sm" data-consent="all">{T.acceptAll}</button>
    </div>
  </section>

  <section class="prefs-pane" role="tabpanel" id="prefs-pane-a11y" aria-labelledby="prefs-tab-a11y" hidden>
    <fieldset class="pref-row pref-text">
      <legend>{T.textSize}</legend>
      <div class="seg-choice">
        {T.textSizes.map((label, i) => (
          <label><input type="radio" name="text" value={i} />{label}</label>
        ))}
      </div>
    </fieldset>
    {toggles.map(t => (
      <label class="pref-row">
        <span><strong>{t.label}</strong><span class="desc">{t.text}</span></span>
        <input type="checkbox" class="switch" role="switch" name={t.name} />
      </label>
    ))}
    <div class="btnrow prefs-actions">
      <button type="button" class="linkbtn" data-a11y-reset>{T.reset}</button>
      <p class="prefs-status" role="status" aria-live="polite" data-saved-text={T.saved}></p>
    </div>
  </section>
</dialog>
