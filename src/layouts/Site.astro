---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { rungs, BOOKING_URL, GTM_ID } from '../data/site';
import Preferences from '../components/Preferences.astro';
import { LANGS, ROUTES, alternatePath, langFromPath, ui } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, ogType = 'website', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const lang = langFromPath(path);
const t = ui(lang);
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const alternates = LANGS.map(l => ({ lang: l, href: new URL(alternatePath(path, l), Astro.site) }));
---
<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    {noindex && <meta name="robots" content="noindex" />}
    {lang === 'en' && !noindex && (
      <script is:inline>
        // Browsers that prefer Polish over English go to the Polish page, unless the visitor has already
        // picked a language with the EN/PL switch (remembered by src/scripts/lang.ts). Runs before paint.
        (function () {
          try { if (localStorage.getItem('dna4d-lang')) return; } catch (e) { return; }
          var prefs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < prefs.length; i++) {
            var tag = String(prefs[i]).toLowerCase().split('-')[0];
            if (tag === 'en') return;
            if (tag === 'pl') {
              var alt = document.querySelector('link[rel="alternate"][hreflang="pl"]');
              if (alt) location.replace(new URL(alt.href).pathname + location.search + location.hash);
              return;
            }
          }
        })();
      </script>
    )}
    <script define:vars={{ gtmId: GTM_ID }}>
      // Accessibility settings and cookie consent, applied before the page draws (see src/scripts/prefs.ts).
      (function () {
        var root = document.documentElement;
        try {
          var a = JSON.parse(localStorage.getItem('dna4d-a11y') || '{}');
          if (a.text === 1 || a.text === 2) root.classList.add('a11y-text-' + a.text);
          ['still', 'contrast', 'links', 'spacing'].forEach(function (k) { if (a[k]) root.classList.add('a11y-' + k); });
        } catch (e) {}

        // Google Consent Mode v2: everything is denied until the visitor chooses. Tag Manager loads only after a yes.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted' });
        window.gtag('set', 'ads_data_redaction', true);
        window.__loadGtm = function () {
          if (window.__gtmLoaded) return;
          window.__gtmLoaded = true;
          window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          document.head.appendChild(s);
        };
        try {
          var c = JSON.parse(localStorage.getItem('dna4d-consent') || 'null');
          if (c && c.v === 1 && Date.now() - c.ts < 31536000000 && (c.analytics || c.marketing)) {
            var g = function (on) { return on ? 'granted' : 'denied'; };
            window.gtag('consent', 'update', { analytics_storage: g(c.analytics), ad_storage: g(c.marketing), ad_user_data: g(c.marketing), ad_personalization: g(c.marketing) });
            window.__loadGtm();
          }
        } catch (e) {}
      })();
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DNA4Digital" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#05080d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // App layout is assumed as soon as JS runs; if the 3D scene never starts, fall back to the plain page.
      document.documentElement.classList.add('js');
      setTimeout(function () { if (!window.__helixReady) document.documentElement.classList.add('no-gl'); }, 8000);
    </script>
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Preferences />
    <div id="stage" transition:persist="stage" aria-hidden="true">
      <canvas id="overlay"></canvas>
    </div>

    <header class="topbar">
      <a class="wordmark" href={ROUTES.home[lang]} aria-label={t.homeAria}>
        {/* One turn of the helix. Each strand darkens as it turns away (the gradients), and its front half is
            drawn again over the rungs, so the strands take turns crossing in front. Same mark as public/favicon.svg. */}
        <svg width="24" height="34" viewBox="0 0 24 34" aria-hidden="true">
          <defs>
            <linearGradient id="mark-teal" gradientUnits="userSpaceOnUse" x1="0" y1="2" x2="0" y2="32">
              <stop offset="0" stop-color="#209285" /><stop offset=".125" stop-color="#29c1ae" /><stop offset=".25" stop-color="#2dd4bf" />
              <stop offset=".375" stop-color="#29c1ae" /><stop offset=".5" stop-color="#209285" /><stop offset=".625" stop-color="#17635c" />
              <stop offset=".75" stop-color="#134f4b" /><stop offset=".875" stop-color="#17635c" /><stop offset="1" stop-color="#209285" />
            </linearGradient>
            <linearGradient id="mark-blue" gradientUnits="userSpaceOnUse" x1="0" y1="2" x2="0" y2="32">
              <stop offset="0" stop-color="#0275b0" /><stop offset=".125" stop-color="#035079" /><stop offset=".25" stop-color="#034162" />
              <stop offset=".375" stop-color="#035079" /><stop offset=".5" stop-color="#0275b0" /><stop offset=".625" stop-color="#009be8" />
              <stop offset=".75" stop-color="#00aaff" /><stop offset=".875" stop-color="#009be8" /><stop offset="1" stop-color="#0275b0" />
            </linearGradient>
          </defs>
          <g fill="none" stroke-width="2.4" stroke-linecap="round">
            <path d="M4 2C4 7.47 20 11.53 20 17S4 26.53 4 32" stroke="url(#mark-teal)" />
            <path d="M20 2C20 7.47 4 11.53 4 17S20 26.53 20 32" stroke="url(#mark-blue)" />
            <path d="M6.34 5.75h11.32M6.34 13.25h11.32M4 17h16M6.34 20.75h11.32M6.34 28.25h11.32" stroke="#bdf5ec" stroke-opacity=".4" stroke-width="1.3" />
            <path d="M4 2C4 7.47 20 11.53 20 17" stroke="url(#mark-teal)" stroke-linecap="butt" />
            <path d="M4 17C4 22.47 20 26.53 20 32" stroke="url(#mark-blue)" stroke-linecap="butt" />
          </g>
        </svg>
        <span class="stack" aria-hidden="true"><span>DNA</span><span><span class="four">4</span>DIGITAL</span></span>
      </a>
      <div class="topbar-right">
        <nav class="lang-switch" aria-label={t.langNav}>
          {alternates.map(a => (
            <a href={a.href.pathname} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>{a.lang.toUpperCase()}</a>
          ))}
        </nav>
        <button type="button" class="icon-btn" data-open-settings="a11y" aria-label={t.settingsButton} title={t.settingsButton}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="4.5" r="1.8" fill="currentColor" stroke="none" />
            <path d="M5 8.5c2.3.7 4.6 1 7 1s4.7-.3 7-1M12 9.5v5M12 14.5l-3 6M12 14.5l3 6" />
          </svg>
        </button>
        <a class="btn btn-ghost btn-sm" href={BOOKING_URL} target="_blank" rel="noopener">{t.bookCall}</a>
      </div>
    </header>

    {/* A separate persist key per language, so switching language swaps the menu labels. */}
    <nav class="rungs" id="rungs" aria-label={t.mainNav} transition:persist={`rungs-${lang}`}>
      {rungs(lang).map((r, i) => (
        <a class="rung-link" href={r.href} data-rung={i}>
          <span class="idx">0{i + 1}</span>{r.name}
        </a>
      ))}
    </nav>

    <slot />

    <script>
      import '../scripts/forms';
      import '../scripts/lang';
      import '../scripts/prefs';
      // three.js is the heavy part, so it loads as its own chunk and never holds up the page or the form.
      import('../scripts/helix');
    </script>
  </body>
</html>
