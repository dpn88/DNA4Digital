---
import Site from '../layouts/Site.astro';
import Panel from '../components/Panel.astro';
import { FALLBACK_RUNG } from '../data/site';
---
<Site title="Page not found | DNA4Digital" description="This page doesn't exist." noindex>
  <Panel rung={FALLBACK_RUNG} kicker="404">
    <h1>This page isn't here</h1>
    <p class="lead">It may have moved when the site was rebuilt. Everything that was here before now lives in one of these places.</p>
    <div class="btnrow">
      <a class="btn btn-primary" href="/">Back to the helix</a>
      <a class="btn btn-ghost" href="/services/">Services</a>
      <a class="btn btn-ghost" href="/contact/">Contact</a>
    </div>
  </Panel>
</Site>
