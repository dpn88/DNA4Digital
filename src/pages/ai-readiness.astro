---
import Site from '../layouts/Site.astro';
import Panel from '../components/Panel.astro';
---
<Site
  title="AI readiness test: eight questions, two minutes | DNA4Digital"
  description="Find out where your organisation sits on the AI curve. Eight questions, two minutes, and practical recommendations for what to do next."
>
  <Panel rung={0} kicker="AI readiness test">
    <h1>Is your company ready for AI?</h1>
    <p class="lead">Eight questions, two minutes. You'll find out where your organisation actually sits on the AI curve, and get my recommendations for what to do next. Nothing is stored or sent anywhere unless you choose to share your score.</p>
    <div class="quiz" data-quiz>
      <p>This test needs JavaScript. If it's turned off, <a href="/contact/?topic=audit">tell me about your situation</a> and I'll give you my view directly.</p>
    </div>
  </Panel>
</Site>
