---
import Site from '../layouts/Site.astro';
import Panel from '../components/Panel.astro';
---
<Site
  title="AI readiness test: eight questions, two minutes | DNA4Digital"
  description="Eight questions, two minutes. You get a score from 0 to 100 and four steps for starting AI implementation in your company."
>
  <Panel rung={0} kicker="AI readiness test">
    <h1>Find out where to start with AI</h1>
    <p class="lead">Eight questions, about two minutes. At the end you'll see a score from 0 to 100 and the four steps I'd start with in your situation. The test runs in your browser and sends nothing unless you choose to share your score.</p>
    <div class="quiz" data-quiz>
      <p>This test needs JavaScript. If it's turned off, <a href="/contact/?topic=audit">tell me about your situation</a> and I'll give you my view directly.</p>
    </div>
  </Panel>
</Site>
