---
import { BOOKING_URL } from '../data/site';
import Site from '../layouts/Site.astro';
const year = new Date().getFullYear();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Nowak',
  jobTitle: 'AI, GTM and process consultant',
  url: 'https://dna4digital.com/',
  worksFor: { '@type': 'Organization', name: 'DNA4Digital', url: 'https://dna4digital.com/' },
  knowsAbout: ['Go-to-market', 'Revenue operations', 'Process improvement', 'Lean Six Sigma', 'AI implementation'],
};
---
<Site
  title="Daniel Nowak | GTM and AI consulting | DNA4Digital"
  description="I clear the path from lead to invoice, then automate the parts that pay back. Audits, training and AI implementation for sales and operations teams."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="home" id="main" data-view="home" data-rung="-1">
    <section class="hero">
      <p class="eyebrow">GTM and AI consulting</p>
      <h1>First I fix the process. <span class="grad">Then I bring in&nbsp;AI.</span></h1>
      <p class="intro">
        <span class="long">I'm Daniel Nowak. I spent thirteen years in hotels and restaurants in Poland and Ireland, then at TTEC I led the Google Customer Solutions team that finished first in EMEA for revenue. Now I look for the places in your company where leads get stuck on their way to an invoice. I fix the process first, and only automate what pays back.</span>
        <span class="short">I'm Daniel Nowak. I clear the hold-ups between lead and invoice, then automate what pays back.</span>
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener">Book a free 30-min call</a>
        <a class="btn btn-ghost" href="/ai-readiness/">Take the AI readiness test (2 min)</a>
      </div>
    </section>

    <div class="proof">
      <div><b>#1</b><span>for revenue in EMEA, my team at Google CS</span></div>
      <div><b>5&times;</b><span>higher funnel engagement after the CRM migration at Sensay</span></div>
      <div><b>30%</b><span>less ticket handling time after the process rebuild at SpotOn</span></div>
    </div>

    <footer class="homefoot">
      &copy; {year} Daniel Nowak / DNA4Digital &middot; <a href="/privacy-policy/">Privacy</a> &middot; <a href="/about/#disclosure">Yameo disclosure</a> &middot; <button type="button" class="linkbtn" data-open-settings="privacy">Cookie settings</button>
    </footer>
  </main>
</Site>
