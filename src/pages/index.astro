---
import { BOOKING_URL } from '../data/site';
import Site from '../layouts/Site.astro';
const year = new Date().getFullYear();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Nowak',
  jobTitle: 'AI, GTM and process consultant',
  url: 'https://dna4digital.com/',
  worksFor: { '@type': 'Organization', name: 'DNA4Digital', url: 'https://dna4digital.com/' },
  knowsAbout: ['Go-to-market', 'Revenue operations', 'Process improvement', 'Lean Six Sigma', 'AI implementation'],
};
---
<Site
  title="Daniel Nowak | AI, GTM and process consulting | DNA4Digital"
  description="I'm Daniel Nowak. I map how your revenue actually moves, remove the friction, then apply AI where it pays off. Audits, training and consulting for GTM and operations teams."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="home" id="main" data-view="home" data-rung="-1">
    <section class="hero">
      <p class="eyebrow">AI &middot; GTM &middot; Process consulting</p>
      <h1>Fix the process. <span class="grad">Then add the AI.</span></h1>
      <p class="intro">
        <span class="long">I'm Daniel Nowak. Eighteen years in operations, from hotel kitchens to running Google Customer Solutions' #1 EMEA revenue team at TTEC. I map how your revenue actually moves, remove the friction, then automate what's worth automating.</span>
        <span class="short">I'm Daniel Nowak. I map how your revenue actually moves, then automate what's worth automating.</span>
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener">Book a free 30-min call</a>
        <a class="btn btn-ghost" href="/ai-readiness/">Take the AI readiness test</a>
      </div>
    </section>

    <div class="proof">
      <div><b>#1</b><span>EMEA revenue team, Google CS</span></div>
      <div><b>5&times;</b><span>funnel engagement, Sensay</span></div>
      <div><b>30%</b><span>faster ticket handling, SpotOn</span></div>
    </div>

    <footer class="homefoot">
      &copy; {year} Daniel Nowak / DNA4Digital &middot; <a href="/privacy-policy/">Privacy</a> &middot; <a href="/about/#disclosure">Yameo disclosure</a> &middot; <button type="button" class="linkbtn" data-open-settings="privacy">Cookie settings</button>
    </footer>
  </main>
</Site>
