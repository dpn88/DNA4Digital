---
import { BOOKING_URL } from '../data/site';
import Site from '../layouts/Site.astro';
const year = new Date().getFullYear();
const MOTTO = 'For only the human touch gives technology its true sense';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Nowak',
  jobTitle: 'AI, GTM and process consultant',
  slogan: MOTTO,
  url: 'https://dna4digital.com/',
  worksFor: { '@type': 'Organization', name: 'DNA4Digital', url: 'https://dna4digital.com/' },
  knowsAbout: ['Go-to-market', 'Revenue operations', 'Process improvement', 'Lean Six Sigma', 'AI implementation'],
};
---
<Site
  title="Daniel Nowak | GTM and AI consulting | DNA4Digital"
  description="I find where companies lose customers before the invoice, then automate what pays back. Audits, training and AI implementation for sales and operations."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="home" id="main" data-view="home" data-rung="-1">
    <section class="hero">
      <p class="eyebrow">Daniel Nowak &middot; GTM and AI consulting</p>
      <h1>Fix the process first. <span class="grad">Then bring in&nbsp;AI.</span></h1>
      <p class="motto">{MOTTO}.</p>
      <p class="intro">
        <span class="long">I find where your company loses customers before the invoice goes out. You get the causes removed first, and automation only where it pays back.</span>
        <span class="long">Thirteen years in hospitality came first, then leading the Google Customer Solutions team at TTEC. My work with AI goes back to the very beginning: personality replicas at Sensay and preserving the tacit knowledge in people's heads. As a Lean Six Sigma Black Belt, I turn it into a written process.</span>
        <span class="short">I find where your company loses customers before the invoice, remove the causes, then automate what pays back.</span>
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener">Book a free 30-min call</a>
        <a class="btn btn-ghost" href="/ai-readiness/">Take the AI readiness test (2 min)</a>
      </div>
    </section>

    <div class="proof">
      <div><b>#1</b><span>for revenue in EMEA, my team at Google CS</span></div>
      <div><b>5&times;</b><span>higher funnel engagement after the CRM migration at Sensay</span></div>
      <div><b>30%</b><span>less ticket handling time after the process rebuild at SpotOn</span></div>
    </div>

    <footer class="homefoot">
      &copy; {year} Daniel Nowak / DNA4Digital &middot; <a href="/privacy-policy/">Privacy</a> &middot; <a href="/about/#disclosure">Yameo disclosure</a> &middot; <button type="button" class="linkbtn" data-open-settings="privacy">Cookie settings</button>
    </footer>
  </main>
</Site>
