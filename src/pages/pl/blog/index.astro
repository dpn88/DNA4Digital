---
import { getCollection } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import Panel from '../../../components/Panel.astro';
import { LINKEDIN_URL } from '../../../data/site';
import { ROUTES } from '../../../i18n';

const posts = (await getCollection('blog', p => !p.data.draft && p.data.lang === 'pl')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Site
  title="Blog: notatki o GTM, procesach i AI | DNA4Digital"
  description="Krótkie, praktyczne notatki o go-to-market, procesach i AI, pisane na podstawie prawdziwych projektów."
>
  <Panel rung={3} kicker="04 · Blog">
    <h1>Notatki z praktyki</h1>
    <p class="lead">Krótkie, praktyczne notatki o go-to-market, procesach i AI, pisane na podstawie prawdziwych projektów, a nie prezentacji dostawców.</p>
    {posts.length > 0 ? (
      posts.map(p => (
        <a class="post" href={`${ROUTES.blog.pl}${p.id}/`}>
          <span class="date">{fmt(p.data.date)}</span>
          <strong>{p.data.title}</strong>
          <span class="excerpt">{p.data.description}</span>
        </a>
      ))
    ) : (
      <p>Pierwsze wpisy właśnie powstają. Do tego czasu <a href={LINKEDIN_URL} rel="noopener">obserwuj DNA4Digital na LinkedInie</a> albo <a href={ROUTES.contact.pl}>wyślij mi pytanie</a>, na które odpowiedź chcesz przeczytać najpierw.</p>
    )}
  </Panel>
</Site>
