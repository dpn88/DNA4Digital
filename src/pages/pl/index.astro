---
import { BOOKING_URL } from '../../data/site';
import { ROUTES } from '../../i18n';
import Site from '../../layouts/Site.astro';
const year = new Date().getFullYear();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Nowak',
  jobTitle: 'Doradca ds. AI, GTM i procesów',
  url: 'https://dna4digital.com/pl/',
  worksFor: { '@type': 'Organization', name: 'DNA4Digital', url: 'https://dna4digital.com/' },
  knowsAbout: ['Go-to-market', 'Revenue operations', 'Optymalizacja procesów', 'Lean Six Sigma', 'Wdrożenia AI'],
};
---
<Site
  title="Daniel Nowak | Doradztwo AI, GTM i procesy | DNA4Digital"
  description="Jestem Daniel Nowak. Mapuję, jak przychody przepływają przez Twoją firmę, naprawiam przekazania, które je spowalniają, a potem wdrażam AI tam, gdzie się zwraca. Audyty, szkolenia i doradztwo dla zespołów sprzedaży i operacji."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="home" id="main" data-view="home" data-rung="-1">
    <section class="hero">
      <p class="eyebrow">AI &middot; GTM &middot; Doradztwo procesowe</p>
      <h1>Najpierw napraw proces. <span class="grad">Potem dodaj&nbsp;AI.</span></h1>
      <p class="intro">
        <span class="long">Jestem Daniel Nowak. Mam za sobą osiemnaście lat w operacjach, od hotelowych kuchni po kierowanie zespołem Google Customer Solutions w TTEC, który zajął 1. miejsce pod względem przychodów w EMEA. Mapuję, jak przychody przepływają przez Twoją firmę, naprawiam przekazania, na których utykają, i automatyzuję kroki, które warto zautomatyzować.</span>
        <span class="short">Jestem Daniel Nowak. Mapuję, jak przychody przepływają przez Twoją firmę, a potem automatyzuję kroki, które warto.</span>
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING_URL} target="_blank" rel="noopener">Umów bezpłatną rozmowę (30 min)</a>
        <a class="btn btn-ghost" href={ROUTES.readiness.pl}>Zrób test gotowości AI</a>
      </div>
    </section>

    <div class="proof">
      <div><b>#1</b><span>zespół przychodowy w EMEA, Google CS</span></div>
      <div><b>5&times;</b><span>zaangażowanie w lejku, Sensay</span></div>
      <div><b>30%</b><span>szybsza obsługa zgłoszeń, SpotOn</span></div>
    </div>

    <footer class="homefoot">
      &copy; {year} Daniel Nowak / DNA4Digital &middot; <a href={ROUTES.privacy.pl}>Prywatność</a> &middot; <a href={`${ROUTES.about.pl}#disclosure`}>Informacja o Yameo</a> &middot; <button type="button" class="linkbtn" data-open-settings="privacy">Ustawienia cookie</button>
    </footer>
  </main>
</Site>
