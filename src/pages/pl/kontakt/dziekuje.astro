    <div class="btnrow">
      <a class="btn btn-primary" href={ROUTES.home.pl}>Powrót do helisy</a>
      <a class="btn btn-ghost" href={ROUTES.work.pl}>Zobacz realizacje</a>
    </div>
  </Panel>
</Site>
